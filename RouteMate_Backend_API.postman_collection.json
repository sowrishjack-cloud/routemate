				{
					"name": "3. User Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.status === 'success' && jsonData.data) {",
									"    if (jsonData.data.token) pm.environment.set('auth_token', jsonData.data.token);",
									"    if (jsonData.data.user && jsonData.data.user.id) pm.environment.set('user_id', jsonData.data.user.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Rohan Sharma\",\n    \"email\": \"rohan_rider_{{$timestamp}}@example.com\",\n    \"phone\": \"9876543210\",\n    \"password\": \"SecurePass123!\",\n    \"city\": \"Bengaluru\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						},
						"description": "Registers a new user in MySQL users table with bcrypt hashed password."
